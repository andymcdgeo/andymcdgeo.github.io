---
// Homepage: bento grid, tile sections and a well-log depth track.
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { XMLParser } from "fast-xml-parser";
import "../styles/tiles.css";
import heroMe from "../assets/images/hero-me.png";
import bookCover from "../assets/images/python_petrophysics_book_image.png";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...olderPosts] = posts;
const morePosts = olderPosts.slice(0, 4);
const publications = await getCollection("publications");
const dataSources = await getCollection("data-sources");
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured === true && project.data.image)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const formatDate = (date) =>
  new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "short", day: "2-digit" }).format(date);

const excerptFor = (post) => post.data.excerpt?.trim() || post.data.description?.trim() || "";

// Section tops: the depth each section "sits" at on the track
const TD = 2500;
const tops = [
  { id: "surface", label: "Surface", depth: 0 },
  { id: "writing", label: "Writing", depth: 1100 },
  { id: "projects", label: "Projects", depth: 1800 },
  { id: "td", label: "TD", depth: TD },
];

const [featuredPost, ...sidePosts] = morePosts;

// Latest YouTube video; the tile falls back to a plain link if the feed is unavailable
let latestVideo = null;
try {
  const response = await fetch("https://www.youtube.com/feeds/videos.xml?channel_id=UCn1O_4_ApzbYwrsUdRoMmOg");
  if (response.ok) {
    const feed = new XMLParser({ ignoreAttributes: false }).parse(await response.text());
    const entry = Array.isArray(feed?.feed?.entry) ? feed.feed.entry[0] : feed?.feed?.entry;
    const videoId = entry?.["yt:videoId"];
    if (videoId) {
      latestVideo = {
        title: typeof entry.title === "string" ? entry.title : entry.title?.["#text"] ?? "",
        link: entry.link?.["@_href"] ?? `https://www.youtube.com/watch?v=${videoId}`,
        thumbnail: `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`,
      };
    }
  }
} catch {
  latestVideo = null;
}
---

<BaseLayout title="Andy McDonald">
  <Navbar slot="nav" />

  <div class="rd">
    <!-- Depth track: fixed on desktop, fills as you scroll -->
    <aside class="rd-track" aria-label="Page depth">
      <div class="rd-track-head">
        <span>DEPTH</span>
        <span>m MD</span>
      </div>
      <div class="rd-track-body">
        <div class="rd-track-fill"></div>
        {Array.from({ length: TD / 100 + 1 }, (_, i) => (
          <span class:list={["rd-tick", i % 5 === 0 && "rd-tick--major"]} style={`top: ${(i * 100 / TD) * 100}%`}>
            {i % 5 === 0 && <em>{(i * 100).toLocaleString("en-GB")}</em>}
          </span>
        ))}
        {tops.map((top) => (
          <a class="rd-top" href={`#${top.id}`} style={`top: ${(top.depth / TD) * 100}%`}>
            <span>{top.label}</span>
          </a>
        ))}
        <div class="rd-bit" aria-hidden="true"></div>
      </div>
      <div class="rd-track-readout"><span id="rd-depth">0</span> m</div>
    </aside>
    <div class="rd-progress" aria-hidden="true"><div></div></div>
    <div class="rd-navdepth" id="rd-navdepth" aria-hidden="true">
      <span class="rd-navdepth-bit"></span><span id="rd-navdepth-val">0</span>&nbsp;m
    </div>

    <div class="rd-main">
      <!-- Bento -->
      <section class="rd-bento" id="surface" data-depth="0">
        <div class="rd-tile rd-intro">
          <div class="rd-label">PETROPHYSICS / PYTHON / AI &amp; ML</div>
          <h1>Subsurface data, made <em>usable.</em></h1>
          <p>
            I'm Andy McDonald, a petrophysicist and product manager. I turn messy, incomplete well data into something
            trusted, before the machine learning ever gets a look in.
          </p>
          <div class="rd-actions">
            <a class="rd-btn rd-btn--primary" href="https://andymcdonaldgeo.substack.com/">Read Subsurface Syntax →</a>
            <a class="rd-btn" href="/about">About me</a>
          </div>
        </div>

        <div class="rd-tile rd-portrait">
          <Image src={heroMe} alt="Andy McDonald portrait" width={640} loading="eager" />
          <div class="rd-portrait-tag">
            <span class="rd-dot"></span> Petrophysicist · Product manager
          </div>
        </div>

        <a class="rd-tile rd-latest" href={`/blog/${latest.slug}`}>
          <div class="rd-latest-media">
            <Image src={latest.data.heroImage} alt="" width={720} />
          </div>
          <div class="rd-latest-body">
            <div class="rd-label">LATEST ARTICLE · {formatDate(latest.data.date).toUpperCase()}</div>
            <h2>{latest.data.title}</h2>
            <p>{excerptFor(latest)}</p>
            <span class="rd-link">Read →</span>
          </div>
        </a>

        <a class="rd-tile rd-substack" href="https://andymcdonaldgeo.substack.com/">
          <div class="rd-label">NEWSLETTER</div>
          <div class="rd-big">200<small>+</small></div>
          <p>readers of <strong>Subsurface Syntax</strong>: AI, ML and Python for the subsurface.</p>
          <span class="rd-link">Subscribe →</span>
        </a>

        <a class="rd-tile rd-lab" href="/labs/pore-lab/">
          <img src="/images/labs/pore-lab.jpg" alt="" width="1200" height="750" />
          <div class="rd-lab-body">
            <span class="rd-chip">3D LAB</span>
            <h3>Pore Lab</h3>
            <p>Change the rock and watch porosity, saturation and permeability rebuild.</p>
          </div>
        </a>

        <a class="rd-tile rd-lab" href="/labs/bore-lab/">
          <img src="/images/labs/bore-lab.jpg" alt="" width="1200" height="750" />
          <div class="rd-lab-body">
            <span class="rd-chip">3D LAB</span>
            <h3>Bore Lab</h3>
            <p>Drill a well and watch its logs being made, lag and invasion included.</p>
          </div>
        </a>

        <a class="rd-tile rd-stat" href="/publications">
          <div class="rd-label">PAPERS</div>
          <div class="rd-big">{publications.length}</div>
          <p>Journal and conference publications</p>
        </a>

        <a class="rd-tile rd-stat" href="/data">
          <div class="rd-label">OPEN DATA</div>
          <div class="rd-big">{dataSources.length}</div>
          <p>Public well data sources, catalogued</p>
        </a>

        {latestVideo ? (
          <a class="rd-tile rd-video" href={latestVideo.link} target="_blank" rel="noopener noreferrer">
            <div class="rd-video-thumb">
              <img src={latestVideo.thumbnail} alt="" width="320" height="180" loading="lazy" />
              <span class="rd-video-play" aria-hidden="true">▶</span>
            </div>
            <div class="rd-label">LATEST VIDEO</div>
            <p>{latestVideo.title}</p>
          </a>
        ) : (
          <a class="rd-tile rd-stat" href="/videos">
            <div class="rd-label">YOUTUBE</div>
            <div class="rd-big rd-big--icon">▶</div>
            <p>Practical Python walkthroughs</p>
          </a>
        )}

        <a class="rd-tile rd-book" href="https://www.andymcdonald.scot/python_well_log_data_book/">
          <Image src={bookCover} alt="" width={200} />
          <div>
            <div class="rd-label">BOOK · WORKING COPY</div>
            <h3>Python for Well Log Analysis</h3>
            <span class="rd-link">Read the draft →</span>
          </div>
        </a>
      </section>

      <!-- Writing -->
      <section class="rd-section" id="writing">
        <div class="rd-section-head">
          <div>
            <div class="rd-label">WRITING · 1,100 m</div>
            <h2 class="rd-h2">More from the blog</h2>
          </div>
          <a class="rd-link" href="/blog">All writing →</a>
        </div>
        <div class="rd-grid">
          <a class="rd-tile rd-post-feature" href={`/blog/${featuredPost.slug}`}>
            <Image src={featuredPost.data.heroImage} alt="" width={900} loading="lazy" />
            <div class="rd-overlay">
              <div class="rd-label">{formatDate(featuredPost.data.date).toUpperCase()}</div>
              <h3>{featuredPost.data.title}</h3>
              <p>{excerptFor(featuredPost)}</p>
            </div>
          </a>
          {sidePosts.slice(0, 2).map((post) => (
            <a class="rd-tile rd-post-small" href={`/blog/${post.slug}`}>
              <Image src={post.data.heroImage} alt="" width={320} loading="lazy" />
              <div>
                <div class="rd-label">{formatDate(post.data.date).toUpperCase()}</div>
                <h3>{post.data.title}</h3>
              </div>
            </a>
          ))}
          <a class="rd-tile rd-post-all" href="/blog">
            <span>Browse all articles</span>
            <em>→</em>
          </a>
        </div>
      </section>

      <!-- Projects -->
      <section class="rd-section" id="projects">
        <div class="rd-section-head">
          <div>
            <div class="rd-label">PROJECTS · 1,800 m</div>
            <h2 class="rd-h2">Selected work</h2>
          </div>
        </div>
        <div class="rd-grid">
          {projects.map((project) => {
            const Tile = project.data.link ? "a" : "div";
            return (
            <Tile
              class="rd-tile rd-project"
              href={project.data.link}
              target={project.data.link ? "_blank" : undefined}
              rel={project.data.link ? "noopener noreferrer" : undefined}
            >
              <img src={project.data.image} alt="" loading="lazy" />
              <div class="rd-overlay">
                <div class="rd-label">{project.data.region.toUpperCase()}</div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                {project.data.link && <span class="rd-link">GitHub →</span>}
              </div>
            </Tile>
            );
          })}
        </div>
      </section>

      <!-- TD -->
      <section class="rd-section" id="td">
        <div class="rd-tile rd-cta">
          <div>
            <div class="rd-label">TD · 2,500 m</div>
            <h2 class="rd-h2">Want the next one in your inbox?</h2>
            <p>Subsurface Syntax: AI, ML and Python for the subsurface.</p>
          </div>
          <a class="rd-btn rd-btn--primary" href="https://andymcdonaldgeo.substack.com/">Subscribe →</a>
        </div>
      </section>
    </div>
  </div>

  <script>
    const root = document.querySelector(".rd");
    const readout = document.getElementById("rd-depth");
    const navDepth = document.getElementById("rd-navdepth");
    const navDepthVal = document.getElementById("rd-navdepth-val");
    const navHome = document.querySelector(".nav-home");
    if (navDepth && navHome) navHome.after(navDepth);

    if (root && readout) {
      const TD = 2500;
      let ticking = false;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        root.style.setProperty("--p", p.toFixed(4));
        const depth = Math.round(p * TD).toLocaleString("en-GB");
        readout.textContent = depth;
        if (navDepthVal) navDepthVal.textContent = depth;
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      window.addEventListener("resize", update);
      update();
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tiles = document.querySelectorAll(".rd-tile");

    // Tiles fade up in a short sequence as each group scrolls into view
    if (!reduceMotion && "IntersectionObserver" in window) {
      tiles.forEach((tile) => {
        const siblings = [...tile.parentElement.children];
        tile.style.transitionDelay = `${(siblings.indexOf(tile) % 6) * 60}ms`;
        tile.classList.add("rd-reveal");
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
            // Drop the stagger once revealed so hover transitions stay snappy
            setTimeout(() => (entry.target.style.transitionDelay = ""), 900);
          });
        },
        { rootMargin: "0px 0px -8% 0px" }
      );
      tiles.forEach((tile) => observer.observe(tile));
    }

    // Soft brass glow that follows the cursor across a tile
    if (!reduceMotion && window.matchMedia("(hover: hover)").matches) {
      tiles.forEach((tile) => {
        tile.addEventListener("pointermove", (event) => {
          const rect = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${event.clientX - rect.left}px`);
          tile.style.setProperty("--my", `${event.clientY - rect.top}px`);
        });
      });
    }
  </script>

</BaseLayout>
