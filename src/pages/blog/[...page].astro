---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import WritingCard from "../../components/WritingCard.astro";
import { getAllWriting, tagLinksFor } from "../../utils/writing";

export async function getStaticPaths({ paginate }) {
  const pageSize = 12;
  return paginate(await getAllWriting(), { pageSize });
}

const { page } = Astro.props;
const pageTitle =
  page.currentPage > 1
    ? `Blog - Page ${page.currentPage} - Andy McDonald`
    : "Blog - Andy McDonald";

const tagLinks = tagLinksFor(await getAllWriting());
---

<BaseLayout title={pageTitle}>
  <Navbar slot="nav" />

  <section class="section page-head">
    <span class="section-kicker">Blog</span>
    <h1>Writing</h1>
    <p class="section-lede">
      Notes on subsurface data, petrophysics, and ML workflows. Articles marked Substack open on
      <a class="section-link" href="https://andymcdonaldgeo.substack.com/">Subsurface Syntax</a>.
    </p>

    <div class="tag-filters" role="list">
      <a href="/blog" class:list={["tag", "tag-link", "is-active"]}>All</a>
      {tagLinks.map((tag) => (
        <a href={`/blog/tag/${tag.slug}`} class:list={["tag", "tag-link"]} data-tag={tag.slug}>
          {tag.label}
        </a>
      ))}
    </div>

    <div class="blog-grid">
      {page.data.map((item) => <WritingCard item={item} />)}
    </div>

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="Blog pages">
        {page.url.prev ? (
          <a class="pagination-link" href={page.url.prev}>Previous</a>
        ) : (
          <span class="pagination-link is-disabled" aria-disabled="true">Previous</span>
        )}
        <span class="pagination-status">
          Page {page.currentPage} of {page.lastPage}
        </span>
        {page.url.next ? (
          <a class="pagination-link" href={page.url.next}>Next</a>
        ) : (
          <span class="pagination-link is-disabled" aria-disabled="true">Next</span>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
