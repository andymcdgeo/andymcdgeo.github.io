---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import WritingCard from "../../../components/WritingCard.astro";
import { slugifyTag } from "../../../utils/slugifyTag";
import { getAllWriting, tagLinksFor } from "../../../utils/writing";

export async function getStaticPaths() {
  return tagLinksFor(await getAllWriting()).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag: tag.label },
  }));
}

const { tag } = Astro.props;
const writing = await getAllWriting();
const tagLinks = tagLinksFor(writing);
const selectedSlug = slugifyTag(tag);
const filtered = writing.filter((item) => item.tags.some((label) => slugifyTag(label) === selectedSlug));
---

<BaseLayout title={`Blog: ${tag} - Andy McDonald`}>
  <Navbar slot="nav" />

  <section class="section page-head">
    <span class="section-kicker">Blog</span>
    <h1>Writing</h1>
    <p class="section-lede section-lede--full">Filtering by tag: {tag} ({filtered.length})</p>

    <div class="tag-filters" role="list">
      <a href="/blog" class:list={["tag", "tag-link"]}>All</a>
      {tagLinks.map((tagLink) => (
        <a
          href={`/blog/tag/${tagLink.slug}`}
          class:list={["tag", "tag-link", tagLink.slug === selectedSlug && "is-active"]}
          data-tag={tagLink.slug}
        >
          {tagLink.label}
        </a>
      ))}
    </div>

    {filtered.length === 0 ? (
      <p class="section-lede">
        No posts found for "{tag}". <a class="section-link" href="/blog">Show all posts</a>.
      </p>
    ) : (
      <div class="blog-grid">
        {filtered.map((item) => <WritingCard item={item} />)}
      </div>
    )}
  </section>
</BaseLayout>
