---
// Redesign preview: bento homepage + well-log depth track.
// Standalone page so it can be compared with / side by side.
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroMe from "../assets/images/hero-me.png";
import bookCover from "../assets/images/python_petrophysics_book_image.png";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...olderPosts] = posts;
const morePosts = olderPosts.slice(0, 4);
const publications = await getCollection("publications");
const dataSources = await getCollection("data-sources");
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured === true && project.data.image)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const formatDate = (date) =>
  new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "short", day: "2-digit" }).format(date);

const excerptFor = (post) => post.data.excerpt?.trim() || post.data.description?.trim() || "";

// Section tops: the depth each section "sits" at on the track
const TD = 2500;
const tops = [
  { id: "surface", label: "Surface", depth: 0 },
  { id: "writing", label: "Writing", depth: 1100 },
  { id: "projects", label: "Projects", depth: 1800 },
  { id: "td", label: "TD", depth: TD },
];

const [featuredPost, ...sidePosts] = morePosts;
---

<BaseLayout title="Andy McDonald (redesign preview)">
  <Navbar slot="nav" />

  <div class="rd">
    <!-- Depth track: fixed on desktop, fills as you scroll -->
    <aside class="rd-track" aria-label="Page depth">
      <div class="rd-track-head">
        <span>DEPTH</span>
        <span>m MD</span>
      </div>
      <div class="rd-track-body">
        <div class="rd-track-fill"></div>
        {Array.from({ length: TD / 100 + 1 }, (_, i) => (
          <span class:list={["rd-tick", i % 5 === 0 && "rd-tick--major"]} style={`top: ${(i * 100 / TD) * 100}%`}>
            {i % 5 === 0 && <em>{(i * 100).toLocaleString("en-GB")}</em>}
          </span>
        ))}
        {tops.map((top) => (
          <a class="rd-top" href={`#${top.id}`} style={`top: ${(top.depth / TD) * 100}%`}>
            <span>{top.label}</span>
          </a>
        ))}
        <div class="rd-bit" aria-hidden="true"></div>
      </div>
      <div class="rd-track-readout"><span id="rd-depth">0</span> m</div>
    </aside>
    <div class="rd-progress" aria-hidden="true"><div></div></div>

    <div class="rd-main">
      <!-- Bento -->
      <section class="rd-bento" id="surface" data-depth="0">
        <div class="rd-tile rd-intro">
          <div class="rd-label">PETROPHYSICS / PYTHON / AI &amp; ML</div>
          <h1>Subsurface data, made <em>usable.</em></h1>
          <p>
            I'm Andy McDonald, a petrophysicist and product manager. I turn messy, incomplete well data into something
            trusted, before the machine learning ever gets a look in.
          </p>
          <div class="rd-actions">
            <a class="rd-btn rd-btn--primary" href="https://andymcdonaldgeo.substack.com/">Read Subsurface Syntax →</a>
            <a class="rd-btn" href="/about">About me</a>
          </div>
        </div>

        <div class="rd-tile rd-portrait">
          <Image src={heroMe} alt="Andy McDonald portrait" width={640} loading="eager" />
          <div class="rd-portrait-tag">
            <span class="rd-dot"></span> Petrophysicist · Product manager
          </div>
        </div>

        <a class="rd-tile rd-latest" href={`/blog/${latest.slug}`}>
          <div class="rd-latest-media">
            <Image src={latest.data.heroImage} alt="" width={720} />
          </div>
          <div class="rd-latest-body">
            <div class="rd-label">LATEST ARTICLE · {formatDate(latest.data.date).toUpperCase()}</div>
            <h2>{latest.data.title}</h2>
            <p>{excerptFor(latest)}</p>
            <span class="rd-link">Read →</span>
          </div>
        </a>

        <a class="rd-tile rd-substack" href="https://andymcdonaldgeo.substack.com/">
          <div class="rd-label">NEWSLETTER</div>
          <div class="rd-big">200<small>+</small></div>
          <p>readers of <strong>Subsurface Syntax</strong>: AI, ML and Python for the subsurface.</p>
          <span class="rd-link">Subscribe →</span>
        </a>

        <a class="rd-tile rd-lab" href="/labs/pore-lab/">
          <img src="/images/labs/pore-lab.jpg" alt="" width="1200" height="750" />
          <div class="rd-lab-body">
            <span class="rd-chip">3D LAB</span>
            <h3>Pore Lab</h3>
            <p>Change the rock and watch porosity, saturation and permeability rebuild.</p>
          </div>
        </a>

        <a class="rd-tile rd-lab" href="/labs/bore-lab/">
          <img src="/images/labs/bore-lab.jpg" alt="" width="1200" height="750" />
          <div class="rd-lab-body">
            <span class="rd-chip">3D LAB</span>
            <h3>Bore Lab</h3>
            <p>Drill a well and watch its logs being made, lag and invasion included.</p>
          </div>
        </a>

        <a class="rd-tile rd-stat" href="/publications">
          <div class="rd-label">PAPERS</div>
          <div class="rd-big">{publications.length}</div>
          <p>Journal and conference publications</p>
        </a>

        <a class="rd-tile rd-stat" href="/data">
          <div class="rd-label">OPEN DATA</div>
          <div class="rd-big">{dataSources.length}</div>
          <p>Public well data sources, catalogued</p>
        </a>

        <a class="rd-tile rd-stat" href="/videos">
          <div class="rd-label">YOUTUBE</div>
          <div class="rd-big rd-big--icon">▶</div>
          <p>Practical Python walkthroughs</p>
        </a>

        <a class="rd-tile rd-book" href="https://www.andymcdonald.scot/python_well_log_data_book/">
          <Image src={bookCover} alt="" width={200} />
          <div>
            <div class="rd-label">BOOK · WORKING COPY</div>
            <h3>Python for Well Log Analysis</h3>
            <span class="rd-link">Read the draft →</span>
          </div>
        </a>
      </section>

      <!-- Writing -->
      <section class="rd-section" id="writing">
        <div class="rd-section-head">
          <div>
            <div class="rd-label">WRITING · 1,100 m</div>
            <h2 class="rd-h2">More from the blog</h2>
          </div>
          <a class="rd-link" href="/blog">All writing →</a>
        </div>
        <div class="rd-grid">
          <a class="rd-tile rd-post-feature" href={`/blog/${featuredPost.slug}`}>
            <Image src={featuredPost.data.heroImage} alt="" width={900} loading="lazy" />
            <div class="rd-overlay">
              <div class="rd-label">{formatDate(featuredPost.data.date).toUpperCase()}</div>
              <h3>{featuredPost.data.title}</h3>
              <p>{excerptFor(featuredPost)}</p>
            </div>
          </a>
          {sidePosts.slice(0, 2).map((post) => (
            <a class="rd-tile rd-post-small" href={`/blog/${post.slug}`}>
              <Image src={post.data.heroImage} alt="" width={320} loading="lazy" />
              <div>
                <div class="rd-label">{formatDate(post.data.date).toUpperCase()}</div>
                <h3>{post.data.title}</h3>
              </div>
            </a>
          ))}
          <a class="rd-tile rd-post-all" href="/blog">
            <span>Browse all articles</span>
            <em>→</em>
          </a>
        </div>
      </section>

      <!-- Projects -->
      <section class="rd-section" id="projects">
        <div class="rd-section-head">
          <div>
            <div class="rd-label">PROJECTS · 1,800 m</div>
            <h2 class="rd-h2">Selected work</h2>
          </div>
        </div>
        <div class="rd-grid">
          {projects.map((project) => (
            <a
              class="rd-tile rd-project"
              href={project.data.link || "#projects"}
              target={project.data.link ? "_blank" : undefined}
              rel={project.data.link ? "noopener noreferrer" : undefined}
            >
              <img src={project.data.image} alt="" loading="lazy" />
              <div class="rd-overlay">
                <div class="rd-label">{project.data.region.toUpperCase()}</div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                {project.data.link && <span class="rd-link">GitHub →</span>}
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- TD -->
      <section class="rd-section" id="td">
        <div class="rd-tile rd-cta">
          <div>
            <div class="rd-label">TD · 2,500 m</div>
            <h2 class="rd-h2">Want the next one in your inbox?</h2>
            <p>Subsurface Syntax: AI, ML and Python for the subsurface.</p>
          </div>
          <a class="rd-btn rd-btn--primary" href="https://andymcdonaldgeo.substack.com/">Subscribe →</a>
        </div>
      </section>
    </div>
  </div>

  <script>
    const root = document.querySelector(".rd");
    const readout = document.getElementById("rd-depth");
    if (root && readout) {
      const TD = 2500;
      let ticking = false;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        root.style.setProperty("--p", p.toFixed(4));
        readout.textContent = Math.round(p * TD).toLocaleString("en-GB");
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      window.addEventListener("resize", update);
      update();
    }
  </script>

  <style is:global>
    .rd {
      --p: 0;
      --track-w: 92px;
      position: relative;
    }

    /* ---------- Depth track ---------- */
    .rd-track {
      position: fixed;
      top: 88px;
      bottom: 24px;
      left: max(12px, calc((100vw - 1100px) / 2 - var(--track-w) - 24px));
      width: var(--track-w);
      display: flex;
      flex-direction: column;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: var(--muted);
      z-index: 5;
    }

    .rd-track-head,
    .rd-track-readout {
      display: flex;
      justify-content: space-between;
      padding: 0.4rem 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg-soft);
      letter-spacing: 0.06em;
    }

    .rd-track-head {
      border-radius: 8px 8px 0 0;
    }

    .rd-track-readout {
      justify-content: center;
      gap: 0.3rem;
      border-radius: 0 0 8px 8px;
      color: var(--accent);
      font-size: 0.72rem;
    }

    .rd-track-body {
      position: relative;
      flex: 1;
      border-left: 1px solid var(--border);
      border-right: 1px solid var(--border);
      background:
        linear-gradient(90deg, transparent 49.5%, rgba(255, 255, 255, 0.08) 49.5%, rgba(255, 255, 255, 0.08) 50.5%, transparent 50.5%);
    }

    .rd-track-fill {
      position: absolute;
      left: calc(50% - 1px);
      top: 0;
      width: 2px;
      height: calc(var(--p) * 100%);
      background: linear-gradient(to bottom, rgba(212, 162, 76, 0.2), var(--accent));
    }

    .rd-bit {
      position: absolute;
      left: 50%;
      top: calc(var(--p) * 100%);
      width: 10px;
      height: 14px;
      transform: translate(-50%, -100%);
      background: var(--accent);
      clip-path: polygon(0 0, 100% 0, 50% 100%);
      filter: drop-shadow(0 0 6px rgba(212, 162, 76, 0.7));
    }

    .rd-tick {
      position: absolute;
      left: 0;
      width: 6px;
      height: 1px;
      background: rgba(255, 255, 255, 0.14);
    }

    .rd-tick--major {
      width: 12px;
      background: rgba(255, 255, 255, 0.3);
    }

    .rd-tick em {
      position: absolute;
      left: 15px;
      top: -0.45rem;
      font-style: normal;
      color: var(--muted);
    }

    .rd-top {
      position: absolute;
      right: 0;
      left: 50%;
      height: 1px;
      background: var(--accent-data);
      opacity: 0.55;
      transition: opacity 0.15s ease;
    }

    .rd-top span {
      position: absolute;
      right: 4px;
      top: 2px;
      color: var(--accent-data);
      font-size: 0.6rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .rd-top:hover {
      opacity: 1;
    }

    .rd-progress {
      display: none;
    }

    /* ---------- Bento ---------- */
    .rd-bento {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: minmax(0, auto);
      gap: 14px;
      scroll-margin-top: 90px;
    }

    .rd-tile {
      position: relative;
      display: block;
      padding: 1.5rem;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--bg-soft);
      overflow: hidden;
      color: var(--text);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    a.rd-tile:hover {
      color: var(--text);
      border-color: rgba(212, 162, 76, 0.5);
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .rd-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      color: var(--accent);
    }

    .rd-link {
      color: var(--accent);
      font-weight: 500;
      font-size: 0.95rem;
    }

    .rd-intro {
      grid-column: span 8;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background:
        radial-gradient(500px 260px at 90% 0%, rgba(212, 162, 76, 0.12), transparent 70%),
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        var(--bg-soft);
      background-size: auto, 32px 32px, 32px 32px, auto;
    }

    .rd-intro h1 {
      font-size: clamp(2.4rem, 5vw, 4rem);
      line-height: 1;
      letter-spacing: -0.04em;
      margin: 1rem 0 1.25rem;
    }

    .rd-intro h1 em {
      font-style: normal;
      color: var(--accent);
    }

    .rd-intro p {
      max-width: 46ch;
      margin: 0;
      color: var(--text-2);
      font-size: 1.1rem;
    }

    .rd-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.75rem;
    }

    .rd-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1.3rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.04);
      font-weight: 500;
    }

    .rd-btn:hover {
      color: var(--text);
      border-color: rgba(212, 162, 76, 0.6);
    }

    .rd-btn--primary {
      border: 0;
      background: var(--accent);
      color: #1a1206;
      font-weight: 600;
    }

    .rd-btn--primary:hover {
      color: #1a1206;
      box-shadow: 0 8px 24px rgba(212, 162, 76, 0.28);
    }

    .rd-portrait {
      grid-column: span 4;
      padding: 0;
      min-height: 420px;
    }

    .rd-portrait img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 20%;
    }

    .rd-portrait-tag {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 14px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.8rem;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(11, 13, 18, 0.6);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      font-size: 0.82rem;
      color: var(--text);
    }

    .rd-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #5fc27a;
      box-shadow: 0 0 0 3px rgba(95, 194, 122, 0.2);
    }

    .rd-latest {
      grid-column: span 8;
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      padding: 0;
    }

    .rd-latest-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .rd-latest-body {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 1.75rem;
    }

    .rd-latest-body h2 {
      margin: 0;
      font-size: 1.5rem;
      line-height: 1.15;
    }

    .rd-latest-body p {
      margin: 0;
      color: var(--text-2);
    }

    .rd-latest-body .rd-link {
      margin-top: auto;
    }

    .rd-substack {
      grid-column: span 4;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background:
        radial-gradient(260px 200px at 100% 100%, rgba(212, 162, 76, 0.16), transparent 70%),
        var(--bg-soft);
    }

    .rd-substack p {
      margin: 0;
      color: var(--text-2);
    }

    .rd-substack .rd-link {
      margin-top: auto;
    }

    .rd-big {
      font-size: 3.6rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.04em;
      margin: 0.4rem 0 0.2rem;
    }

    .rd-big small {
      font-size: 0.5em;
      color: var(--accent);
    }

    .rd-big--icon {
      font-size: 2.6rem;
      color: var(--accent);
      margin: 0.8rem 0 0.4rem;
    }

    .rd-lab {
      grid-column: span 6;
      padding: 0;
      min-height: 300px;
    }

    .rd-lab img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .rd-lab:hover img {
      transform: scale(1.04);
    }

    .rd-lab-body {
      position: absolute;
      inset: auto 0 0 0;
      padding: 4rem 1.5rem 1.4rem;
      background: linear-gradient(to top, rgba(11, 13, 18, 0.95), rgba(11, 13, 18, 0.6) 60%, transparent);
    }

    .rd-lab-body h3 {
      margin: 0.5rem 0 0.25rem;
      font-size: 1.6rem;
    }

    .rd-lab-body p {
      margin: 0;
      color: var(--text-2);
      max-width: 40ch;
    }

    .rd-chip {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      border: 1px solid rgba(116, 208, 255, 0.4);
      background: rgba(116, 208, 255, 0.1);
      color: var(--accent-data);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.06em;
    }

    .rd-stat {
      grid-column: span 3;
    }

    .rd-stat p {
      margin: 0;
      color: var(--text-2);
      font-size: 0.92rem;
    }

    .rd-book {
      grid-column: span 3;
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .rd-book img {
      width: 64px;
      height: auto;
      border-radius: 6px;
      flex-shrink: 0;
    }

    .rd-book h3 {
      margin: 0.35rem 0;
      font-size: 1rem;
      line-height: 1.25;
    }

    /* ---------- Sections below the bento: same tile language ---------- */
    .rd-section {
      padding-top: 4.5rem;
      scroll-margin-top: 60px;
    }

    .rd-section-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 1.1rem;
    }

    .rd-h2 {
      font-size: clamp(1.7rem, 3vw, 2.2rem);
      letter-spacing: -0.03em;
      margin: 0.35rem 0 0;
    }

    .rd-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 14px;
    }

    /* Image tiles with text laid over a dark gradient (writing feature + projects) */
    .rd-post-feature,
    .rd-project {
      padding: 0;
      min-height: 340px;
    }

    .rd-post-feature img,
    .rd-project img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease, filter 0.3s ease;
    }

    a.rd-post-feature:hover img,
    a.rd-project:hover img {
      transform: scale(1.04);
    }

    .rd-overlay {
      position: absolute;
      inset: auto 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 5rem 1.5rem 1.4rem;
      background: linear-gradient(to top, rgba(11, 13, 18, 0.97) 35%, rgba(11, 13, 18, 0.75) 65%, transparent);
    }

    .rd-overlay h3 {
      margin: 0;
      font-size: 1.35rem;
      line-height: 1.2;
    }

    .rd-overlay p {
      margin: 0;
      color: var(--text-2);
      font-size: 0.95rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .rd-post-feature {
      grid-column: span 7;
      grid-row: span 3;
      min-height: 420px;
    }

    .rd-post-feature h3 {
      font-size: 1.6rem;
    }

    .rd-post-small {
      grid-column: span 5;
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 1rem;
      align-items: center;
      padding: 0.9rem;
    }

    .rd-post-small img {
      width: 110px;
      height: 80px;
      object-fit: cover;
      border-radius: 10px;
      display: block;
    }

    .rd-post-small h3 {
      margin: 0.35rem 0 0;
      font-size: 1rem;
      line-height: 1.3;
    }

    .rd-post-all {
      grid-column: span 5;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 500;
      color: var(--text-2);
    }

    .rd-post-all em {
      font-style: normal;
      color: var(--accent);
      font-size: 1.2rem;
    }

    /* Projects: 2 x 2, figures dimmed so the white charts do not glare */
    .rd-project {
      grid-column: span 6;
    }

    .rd-project img {
      object-position: top;
      filter: brightness(0.8) saturate(0.9);
    }

