---
const { pathname } = Astro.url;
const isBlog = pathname === "/blog" || pathname.startsWith("/blog/");
const isVideos = pathname === "/videos" || pathname.startsWith("/videos/");
const isData = pathname === "/data" || pathname.startsWith("/data/");
const isNotionTemplates = pathname === "/notion-templates" || pathname.startsWith("/notion-templates/");
const isPublications = pathname === "/publications" || pathname.startsWith("/publications/");
const isAbout = pathname === "/about" || pathname.startsWith("/about/");
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-left nav-home" href="/">Andy McDonald</a>
    <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      <span class="nav-toggle-text">Menu</span>
    </button>
    <nav id="site-nav" class="nav-right">
      <a href="/blog" aria-current={isBlog ? "page" : undefined}>Blog</a>
      <a href="/videos" aria-current={isVideos ? "page" : undefined}>Videos</a>
      <a href="/data" aria-current={isData ? "page" : undefined}>Open Datasets</a>
      <a href="/publications" aria-current={isPublications ? "page" : undefined}>Publications</a>
      <a href="/notion-templates" aria-current={isNotionTemplates ? "page" : undefined}>Notion Templates</a>
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" type="button" aria-expanded="false" aria-controls="labs-menu">
          Labs <span class="nav-caret" aria-hidden="true"></span>
        </button>
        <div class="nav-dropdown-menu" id="labs-menu">
          <a href="/labs/pore-lab/">
            <span class="nav-dropdown-title">Pore Lab</span>
            <span class="nav-dropdown-desc">Porosity, saturation and permeability in 3D</span>
          </a>
          <a href="/labs/bore-lab/">
            <span class="nav-dropdown-title">Bore Lab</span>
            <span class="nav-dropdown-desc">Drill a well and watch its logs being made</span>
          </a>
          <a href="/labs/probe-lab/">
            <span class="nav-dropdown-title">Probe Lab</span>
            <span class="nav-dropdown-desc">See how each logging tool measures the rock</span>
          </a>
          <a href="/labs/fit-lab/">
            <span class="nav-dropdown-title">Fit Lab</span>
            <span class="nav-dropdown-desc">How machine learning learns from well logs</span>
          </a>
          <a class="nav-dropdown-all" href="/labs/">
            <span class="nav-dropdown-title">All labs →</span>
          </a>
        </div>
      </div>
      <a href="/about" aria-current={isAbout ? "page" : undefined}>About Me</a>
    </nav>
  </div>
</header>
